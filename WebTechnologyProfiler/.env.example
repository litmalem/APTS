WTP_CLIENT_TOKEN=
# Optional exact-authority allowlist for standalone remote fingerprinting.
# Empty by default: remote standalone scans are disabled.
# Entries may be a hostname/IP (all ports), hostname/IP:port, or full HTTP(S) URL.
# Full URLs are reduced to exact host and effective port; path is ignored.
# Example: WTP_REMOTE_ALLOWLIST=lab.example.test,192.0.2.10:8443,[2001:db8::10]:443
WTP_REMOTE_ALLOWLIST=
