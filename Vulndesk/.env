# NVD
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=c552af12-e6b3-440f-b6c3-dce747918de4
NVD_PAGE_SIZE=2000

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=vulndesk
DB_USER=root
DB_PASSWORD=tigad

# App
APP_TITLE=VulnDesk - Vulnerability Viewer
# NVD CVE synchronization reliability
NVD_TIMEOUT_SECONDS=90
NVD_REQUEST_DELAY_SECONDS=0.6
NVD_MAX_RETRIES=5
NVD_BACKOFF_BASE_SECONDS=2
NVD_DB_BATCH_SIZE=100
NVD_SKIP_UNCHANGED=true
NVD_INCREMENTAL_WINDOW_DAYS=120
NVD_INCREMENTAL_INITIAL_START=2024-01-01T00:00:00+00:00

# Packet-safe NVD database writes
NVD_DB_PARENT_WRITE_BATCH_SIZE=100
NVD_DB_CHILD_WRITE_BATCH_SIZE=500
NVD_DB_MAX_STATEMENT_BYTES=524288
NVD_DB_TRANSIENT_RETRIES=2
NVD_DB_RETRY_BASE_SECONDS=1
NVD_RAW_JSON_STORAGE=compressed_chunks
NVD_RAW_JSON_CHUNK_BYTES=131072
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=15
DB_READ_TIMEOUT_SECONDS=180
DB_WRITE_TIMEOUT_SECONDS=180

# APTS Governance & Safety Plane - Stage 1
GOVERNANCE_ENABLED=true
GOVERNANCE_BASE_URL=http://127.0.0.1:8770
GOVERNANCE_TIMEOUT_SECONDS=5