+function Get-OptionalNestedValue {
+    param(
+        $Object,
+        [string[]]$Path,
+        $Default = $null
+    )
+
+    $current = $Object
+    foreach ($segment in $Path) {
+        if ($null -eq $current) { return $Default }
+        $prop = $current.PSObject.Properties[$segment]
+        if ($null -eq $prop) { return $Default }
+        $current = $prop.Value
+    }
+    if ($null -eq $current) { return $Default }
+    return $current
+}
