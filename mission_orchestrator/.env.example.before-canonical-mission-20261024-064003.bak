# Base URL Mission for governed WPT intake, e.g. http://127.0.0.1:8780
APTS_WTP_DISPATCH_URL=
# Bearer token shared with MISSION_WPT_INTAKE_TOKEN (minimum 32 characters)
APTS_WTP_DISPATCH_TOKEN=
# Optional token for authenticating non-loopback WPT API clients
WTP_CLIENT_TOKEN=

# Opt in to the Mission worker submitting exact, declared URL targets to the
# governed WPT intake after Mission is RUNNING and Pentest task authority exists.
# Intake only queues a Stage 6 request; it does not authorize target I/O.
APTS_AUTONOMOUS_WPT_INTAKE=0
