+def _explicit_tcp_connect_roe_allows(boundary: Mapping[str, Any], proposal: Mapping[str, Any]) -> bool:
+    """Active Recon requires a positive, explicit RoE grant and bounded budget."""
+    roe = boundary.get("roe", {})
+    budget = boundary.get("constraints", {}).get("resource_budget", {})
+    allowed_classes = set(roe.get("allowed_action_classes", []))
+    allowed_techniques = set(roe.get("allowed_techniques", []))
+    prohibited_classes = set(roe.get("prohibited_action_classes", []))
+    prohibited_techniques = set(roe.get("prohibited_techniques", []))
+    return (
+        RECONNAISSANCE_ACTION_CLASS in allowed_classes
+        and RECONNAISSANCE_ACTION_CLASS not in prohibited_classes
+        and proposal.get("technique") in allowed_techniques
+        and proposal.get("technique") not in prohibited_techniques
+        and isinstance(roe.get("maximum_concurrency"), int)
+        and not isinstance(roe.get("maximum_concurrency"), bool)
+        and roe["maximum_concurrency"] >= proposal.get("active_concurrency", 1)
+        and isinstance(budget.get("max_network_requests"), int)
+        and not isinstance(budget.get("max_network_requests"), bool)
+        and budget["max_network_requests"] >= proposal.get("rate_cost", 1)
+    )
