{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_sha256",
    "execution_id",
    "idempotency_key",
    "invocation_request_id",
    "requested_by",
    "schema_version"
  ],
  "properties": {
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "invocation_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schema_version": {
      "const": "apts-execution-adapter-intake-v1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$"
    }
  }
}
