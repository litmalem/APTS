{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apts-canonical-action-envelope-v1",
  "title": "APTS canonical action envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_version",
    "contract_sha256",
    "intake",
    "execution_request",
    "source_binding",
    "status",
    "semantics",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "apts-canonical-action-envelope-v1"
    },
    "control_version": {
      "const": "stage6.1-canonical-execution-request-contract"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intake": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "request_id",
            "idempotency_key",
            "exploitation_run_id",
            "exploit_action_proposal_id",
            "proposal_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "apts-execution-request-intake-v1"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "idempotency_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "exploitation_run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "exploit_action_proposal_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "proposal_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source_type",
            "request_id",
            "idempotency_key",
            "recon_action_id",
            "recon_request_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "apts-execution-request-intake-v2"
            },
            "source_type": {
              "const": "STAGE5_2_RECON_ACTION_REQUEST"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "idempotency_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "recon_action_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "recon_request_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source_type",
            "request_id",
            "idempotency_key",
            "enumeration_run_id",
            "enumeration_proposal_ref",
            "proposal_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "apts-execution-request-intake-v3"
            },
            "source_type": {
              "const": "STAGE5_3_ENUMERATION_ACTION_PROPOSAL"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "idempotency_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "enumeration_run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "enumeration_proposal_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "proposal_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source_type",
            "request_id",
            "idempotency_key",
            "wpt_intake_id",
            "wpt_intake_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "apts-execution-request-intake-v4"
            },
            "source_type": {
              "const": "WPT_GOVERNED_INTAKE"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "idempotency_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "wpt_intake_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "wpt_intake_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "execution_request": {
      "title": "APTS ExecutionRequest core",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_id",
        "mission_id",
        "task_id",
        "pentest_id",
        "proposing_agent",
        "action",
        "target",
        "parameters",
        "evidence_basis",
        "authorization_requirement",
        "integrity"
      ],
      "properties": {
        "schema_version": {
          "const": "apts-execution-request-v1"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^exec-[A-Za-z0-9._:@\\-]*$",
          "maxLength": 200
        },
        "mission_id": {
          "type": "string",
          "pattern": "^mission-gmo-[A-Za-z0-9._:@\\-]*$",
          "maxLength": 200
        },
        "task_id": {
          "type": "string",
          "pattern": "^ptask-[A-Za-z0-9._:@\\-]*$",
          "maxLength": 200
        },
        "pentest_id": {
          "type": "string",
          "pattern": "^pentest-[A-Za-z0-9._:@\\-]*$",
          "maxLength": 200
        },
        "proposing_agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_id",
            "role",
            "orchestration_id",
            "subtask_id"
          ],
          "properties": {
            "agent_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "role": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "orchestration_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "subtask_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_class",
            "capability_id",
            "technique"
          ],
          "properties": {
            "action_class": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "capability_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "technique": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_type",
            "target_value"
          ],
          "properties": {
            "target_type": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "target_value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
            }
          }
        },
        "parameters": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "validation_task_id",
                "expected_evidence",
                "estimated_impact"
              ],
              "properties": {
                "validation_task_id": {
                  "type": "string",
                  "pattern": "^valtask-[A-Za-z0-9._:@\\-]*$",
                  "maxLength": 200
                },
                "expected_evidence": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
                  }
                },
                "estimated_impact": {
                  "enum": [
                    "NONE",
                    "LOW",
                    "MODERATE",
                    "HIGH",
                    "CRITICAL",
                    "DESTRUCTIVE"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_action_id",
                "expected_evidence",
                "estimated_impact"
              ],
              "properties": {
                "source_action_id": {
                  "type": "string",
                  "pattern": "^rareq-[A-Za-z0-9._:@\\-]*$",
                  "maxLength": 200
                },
                "expected_evidence": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
                  }
                },
                "estimated_impact": {
                  "enum": [
                    "NONE",
                    "LOW",
                    "MODERATE",
                    "HIGH",
                    "CRITICAL",
                    "DESTRUCTIVE"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_proposal_id",
                "expected_evidence",
                "estimated_impact"
              ],
              "properties": {
                "source_proposal_id": {
                  "type": "string",
                  "pattern": "^actp-[A-Za-z0-9._:@\\-]*$",
                  "maxLength": 200
                },
                "expected_evidence": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
                  }
                },
                "estimated_impact": {
                  "enum": [
                    "NONE",
                    "LOW",
                    "MODERATE",
                    "HIGH",
                    "CRITICAL",
                    "DESTRUCTIVE"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_wpt_intake_id",
                "expected_evidence",
                "estimated_impact"
              ],
              "properties": {
                "source_wpt_intake_id": {
                  "type": "string",
                  "pattern": "^wptreq-[A-Za-z0-9._:@\\-]*$",
                  "maxLength": 200
                },
                "expected_evidence": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
                  }
                },
                "estimated_impact": {
                  "enum": [
                    "NONE",
                    "LOW",
                    "MODERATE",
                    "HIGH",
                    "CRITICAL",
                    "DESTRUCTIVE"
                  ]
                }
              }
            }
          ]
        },
        "evidence_basis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "canonical_sha256"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^evi-[A-Za-z0-9._:@\\-]*$",
                "maxLength": 200
              },
              "canonical_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "authorization_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "revalidation_required",
            "required_checks",
            "human_review_required",
            "policy_reference"
          ],
          "properties": {
            "authority": {
              "const": "EXTERNAL_APTS_GSS"
            },
            "revalidation_required": {
              "const": true
            },
            "required_checks": {
              "const": [
                "SCOPE",
                "ROE",
                "POLICY",
                "RISK",
                "EXPIRY",
                "REVOCATION",
                "TARGET",
                "TECHNIQUE"
              ]
            },
            "human_review_required": {
              "type": "boolean"
            },
            "policy_reference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy_decision_id",
                "policy_decision_hash",
                "policy_version",
                "reference_sha256"
              ],
              "properties": {
                "policy_decision_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
                  "maxLength": 200
                },
                "policy_decision_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "policy_version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "reference_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "canonicalization",
            "hash_domain",
            "canonical_sha256"
          ],
          "properties": {
            "algorithm": {
              "const": "SHA-256"
            },
            "canonicalization": {
              "const": "UTF8_SORTED_JSON_V1"
            },
            "hash_domain": {
              "const": "APTS_STAGE6_1_EXECUTION_REQUEST_V1"
            },
            "canonical_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pentest_task_id",
        "task_artifact_sha256",
        "task_binding_sha256",
        "source_run_output_sha256",
        "source_run_evidence_bundle_sha256",
        "action_proposal_ref",
        "action_proposal_sha256",
        "orchestration_graph_sha256",
        "scope_sha256",
        "roe_sha256",
        "constraints_sha256",
        "policy_reference_sha256",
        "validation_decision_sha256",
        "exploitation_decision_sha256",
        "stage5_closure_contract_sha256"
      ],
      "properties": {
        "pentest_task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "task_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_run_output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_run_evidence_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action_proposal_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "action_proposal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "orchestration_graph_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "roe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "constraints_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_reference_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validation_decision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exploitation_decision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stage5_closure_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "status": {
      "const": "AWAITING_AUTHORIZATION"
    },
    "semantics": {
      "const": {
        "request_is_authorization": false,
        "authorization_minted": false,
        "execution_authorized": false,
        "dispatch_performed": false,
        "tool_invocation_performed": false,
        "external_network_io_performed": false,
        "target_actuation": false,
        "action_result_created": false,
        "new_target_evidence_created": false
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "hash_domain",
        "canonical_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "UTF8_SORTED_JSON_V1"
        },
        "hash_domain": {
          "const": "APTS_STAGE6_1_CANONICAL_ACTION_ENVELOPE_V1"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
