{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revalidation_id",
    "idempotency_key",
    "execution_id",
    "requested_by",
    "schema_version",
    "envelope_sha256"
  ],
  "properties": {
    "revalidation_id": {
      "type": "string",
      "pattern": "^eauthreq-[A-Za-z0-9._:@\\-]+$",
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
      "maxLength": 200
    },
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[A-Za-z0-9._:@\\-]+$",
      "maxLength": 200
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
      "maxLength": 200
    },
    "schema_version": {
      "const": "apts-execution-authorization-intake-v1"
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
