{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_request_id",
    "idempotency_key",
    "mission_id",
    "reason",
    "requested_by",
    "schema_version"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "command_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$"
    },
    "schema_version": {
      "const": "apts-execution-runtime-kill-v1"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$"
    }
  }
}
