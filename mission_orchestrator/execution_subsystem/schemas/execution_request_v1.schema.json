{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apts-execution-request-v1",
  "title": "APTS ExecutionRequest core",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "mission_id",
    "task_id",
    "pentest_id",
    "proposing_agent",
    "action",
    "target",
    "parameters",
    "evidence_basis",
    "authorization_requirement"
  ],
  "properties": {
    "schema_version": {
      "const": "apts-execution-request-v1"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[A-Za-z0-9._:@\\-]*$",
      "maxLength": 200
    },
    "mission_id": {
      "type": "string",
      "pattern": "^mission-gmo-[A-Za-z0-9._:@\\-]*$",
      "maxLength": 200
    },
    "task_id": {
      "type": "string",
      "pattern": "^ptask-[A-Za-z0-9._:@\\-]*$",
      "maxLength": 200
    },
    "pentest_id": {
      "type": "string",
      "pattern": "^pentest-[A-Za-z0-9._:@\\-]*$",
      "maxLength": 200
    },
    "proposing_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role",
        "orchestration_id",
        "subtask_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "orchestration_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "subtask_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_class",
        "capability_id",
        "technique"
      ],
      "properties": {
        "action_class": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "technique": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type",
        "target_value"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
          "maxLength": 200
        },
        "target_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
        }
      }
    },
    "parameters": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validation_task_id",
            "expected_evidence",
            "estimated_impact"
          ],
          "properties": {
            "validation_task_id": {
              "type": "string",
              "pattern": "^valtask-[A-Za-z0-9._:@\\-]*$",
              "maxLength": 200
            },
            "expected_evidence": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
              }
            },
            "estimated_impact": {
              "enum": [
                "NONE",
                "LOW",
                "MODERATE",
                "HIGH",
                "CRITICAL",
                "DESTRUCTIVE"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_action_id",
            "expected_evidence",
            "estimated_impact"
          ],
          "properties": {
            "source_action_id": {
              "type": "string",
              "pattern": "^rareq-[A-Za-z0-9._:@\\-]*$",
              "maxLength": 200
            },
            "expected_evidence": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
              }
            },
            "estimated_impact": {
              "enum": [
                "NONE",
                "LOW",
                "MODERATE",
                "HIGH",
                "CRITICAL",
                "DESTRUCTIVE"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_proposal_id",
            "expected_evidence",
            "estimated_impact"
          ],
          "properties": {
            "source_proposal_id": {
              "type": "string",
              "pattern": "^actp-[A-Za-z0-9._:@\\-]*$",
              "maxLength": 200
            },
            "expected_evidence": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
              }
            },
            "estimated_impact": {
              "enum": [
                "NONE",
                "LOW",
                "MODERATE",
                "HIGH",
                "CRITICAL",
                "DESTRUCTIVE"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_wpt_intake_id",
            "expected_evidence",
            "estimated_impact"
          ],
          "properties": {
            "source_wpt_intake_id": {
              "type": "string",
              "pattern": "^wptreq-[A-Za-z0-9._:@\\-]*$",
              "maxLength": 200
            },
            "expected_evidence": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^[^\\s\\x00-\\x1f\\ud800-\\udfff](?:[^\\x00-\\x1f\\ud800-\\udfff]*[^\\s\\x00-\\x1f\\ud800-\\udfff])?$"
              }
            },
            "estimated_impact": {
              "enum": [
                "NONE",
                "LOW",
                "MODERATE",
                "HIGH",
                "CRITICAL",
                "DESTRUCTIVE"
              ]
            }
          }
        }
      ]
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "canonical_sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^evi-[A-Za-z0-9._:@\\-]*$",
            "maxLength": 200
          },
          "canonical_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "authorization_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "revalidation_required",
        "required_checks",
        "human_review_required",
        "policy_reference"
      ],
      "properties": {
        "authority": {
          "const": "EXTERNAL_APTS_GSS"
        },
        "revalidation_required": {
          "const": true
        },
        "required_checks": {
          "const": [
            "SCOPE",
            "ROE",
            "POLICY",
            "RISK",
            "EXPIRY",
            "REVOCATION",
            "TARGET",
            "TECHNIQUE"
          ]
        },
        "human_review_required": {
          "type": "boolean"
        },
        "policy_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_decision_id",
            "policy_decision_hash",
            "policy_version",
            "reference_sha256"
          ],
          "properties": {
            "policy_decision_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$",
              "maxLength": 200
            },
            "policy_decision_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "policy_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "reference_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
