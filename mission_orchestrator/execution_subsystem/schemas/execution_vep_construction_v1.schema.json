{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "envelope_sha256",
    "evidence_sha256",
    "expected_head_sha256",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "apts-execution-vep-construction-v1"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@\\-]{0,199}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_head_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
