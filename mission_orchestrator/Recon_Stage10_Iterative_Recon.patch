@@ -0,0 +1,57 @@
+PRAGMA foreign_keys = OFF;
+
+CREATE TABLE pentest_recon_runs_v10 (
+    recon_run_id TEXT PRIMARY KEY,
+    request_id TEXT NOT NULL UNIQUE,
+    idempotency_key TEXT NOT NULL UNIQUE,
+    orchestration_id TEXT NOT NULL,
+    subtask_id TEXT NOT NULL,
+    pentest_task_id TEXT NOT NULL,
+    mission_id TEXT NOT NULL,
+    pentest_id TEXT NOT NULL,
+    agent_id TEXT NOT NULL,
+    capability_id TEXT NOT NULL,
+    run_status TEXT NOT NULL,
+    request_sha256 TEXT NOT NULL,
+    request_json TEXT NOT NULL,
+    output_sha256 TEXT NOT NULL,
+    output_json TEXT NOT NULL,
+    evidence_bundle_sha256 TEXT NOT NULL,
+    evidence_bundle_json TEXT NOT NULL,
+    created_at TEXT NOT NULL,
+    completed_at TEXT NOT NULL,
+    iteration_index INTEGER NOT NULL DEFAULT 1 CHECK (iteration_index >= 1),
+    parent_recon_run_id TEXT,
+    source_action_id TEXT,
+    source_result_sha256 TEXT,
+    UNIQUE (orchestration_id, iteration_index),
+    FOREIGN KEY (orchestration_id) REFERENCES pentest_agentic_orchestrations(orchestration_id) ON DELETE CASCADE,
+    FOREIGN KEY (pentest_task_id) REFERENCES pentest_tasks(pentest_task_id) ON DELETE CASCADE,
+    FOREIGN KEY (parent_recon_run_id) REFERENCES pentest_recon_runs_v10(recon_run_id)
+);
+
+INSERT INTO pentest_recon_runs_v10 (
+    recon_run_id, request_id, idempotency_key, orchestration_id, subtask_id, pentest_task_id,
+    mission_id, pentest_id, agent_id, capability_id, run_status, request_sha256, request_json,
+    output_sha256, output_json, evidence_bundle_sha256, evidence_bundle_json, created_at, completed_at,
+    iteration_index
+)
+SELECT recon_run_id, request_id, idempotency_key, orchestration_id, subtask_id, pentest_task_id,
+       mission_id, pentest_id, agent_id, capability_id, run_status, request_sha256, request_json,
+       output_sha256, output_json, evidence_bundle_sha256, evidence_bundle_json, created_at, completed_at, 1
+FROM pentest_recon_runs;
+
+DROP TABLE pentest_recon_runs;
+ALTER TABLE pentest_recon_runs_v10 RENAME TO pentest_recon_runs;
+CREATE INDEX IF NOT EXISTS idx_pentest_recon_runs_task ON pentest_recon_runs(pentest_task_id, created_at);
+CREATE INDEX IF NOT EXISTS idx_pentest_recon_runs_mission ON pentest_recon_runs(mission_id, created_at);
+CREATE INDEX IF NOT EXISTS idx_pentest_recon_runs_pentest ON pentest_recon_runs(pentest_id, created_at);
+CREATE INDEX IF NOT EXISTS idx_pentest_recon_runs_orchestration_iteration
+    ON pentest_recon_runs(orchestration_id, iteration_index DESC);
+
+UPDATE pentest_repository_meta
+SET migration_level=10, schema_version='apts-pentest-reconnaissance-agent-repository-v10',
+    updated_at=strftime('%Y-%m-%dT%H:%M:%fZ','now')
+WHERE repository_id='pentest-local-task-repository';
+
+PRAGMA foreign_keys = ON;
