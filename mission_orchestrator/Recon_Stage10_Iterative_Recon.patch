+            "actor": "STAGE6_RECON_ITERATION",
+            "boundary": parent["request"]["boundary"],
+            "observations": [*prior_observations, result_observation],
+            "metadata": {"iteration": {"parent_recon_run_id": parent_id, "source_action_id": action_id,
+                                         "source_result_sha256": result_sha}},
+        }
+        run, created = self.repository.run_reconnaissance(orchestration_id, new_request, iteration_context={
