+                    parsed_base.hostname is not None and ipaddress.ip_address(parsed_base.hostname).is_loopback
+                )
+            except ValueError:
+                is_loopback = False
+            if parsed_base.scheme != "http" or not is_loopback or parsed_base.username or parsed_base.password:
+                raise ReconnaissanceAgentValidationError("Stage 6 result API must use an HTTP loopback endpoint")
+            request = Request(base + "/api/execution/recon-action-requests/" + action_id + "/results",
+                              headers={"Accept": "application/json"}, method="GET")
