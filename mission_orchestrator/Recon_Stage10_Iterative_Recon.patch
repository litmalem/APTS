+            "source_result_sha256": result_sha,
+        })
+        return {"status": "completed" if created else "replayed", "created": created, "replayed": not created,
+                "control_version": RECONNAISSANCE_AGENT_CONTROL_VERSION, "run": run,
+                "previous_run_mutated": False, "execution_started": False,
