+            raise ReconnaissanceAgentIntegrityError("Stage 6 result proposal or orchestration binding mismatch")
+        if latest.get("mission_id") != parent["mission_id"] or latest.get("task_id") != parent["pentest_task_id"]:
+            raise ReconnaissanceAgentIntegrityError("Stage 6 result mission/task binding mismatch")
+        result_sha = latest["integrity"]["canonical_sha256"]
+        digest = sha256_hex({"parent_recon_run_id": parent_id, "action_id": action_id, "result_sha256": result_sha})
+        prior_observations = list(parent["request"]["observations"])
+        result_observation = {
+            "observation_id": "stage6-result-" + digest[:32],
+            "kind": "RAW_EVIDENCE",
+            "target": {"target_type": action["target_ref"]["target_type"], "target_value": action["target_ref"]["target_value"]},
+            "summary": "A sealed Stage 6 execution result was returned for Recon reassessment.",
+            "attributes": {
+                "runtime_state": latest["runtime_state"],
+                "result_status": latest["execution_result"]["status"],
+                "reason_codes": latest["execution_result"]["reason_codes"],
+                "observation": latest["execution_result"]["observation"],
+                "evidence_id": latest["evidence"]["evidence_id"],
+                "evidence_manifest_sha256": latest["evidence"]["manifest_sha256"],
+            },
+            "confidence": 0.7,
+            "observed_at": _utc_now_z(),
+            "source": {"source_kind": "STAGE6_EXECUTION_RESULT", "source_id": latest["attempt_id"],
