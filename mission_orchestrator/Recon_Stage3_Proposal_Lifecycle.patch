+    def validate_recon_action_request_for_stage6(self, action_id: str) -> dict[str, Any]:
+        """Revalidate the stored immutable Action Request before a Stage 6 intake."""
+        self.initialize()
+        action_id = _canonical_id(action_id, "action_id", prefix="rareq-")
+        matches: list[tuple[dict[str, Any], dict[str, Any]]] = []
+        for run in self.list_recon_runs(limit=500):
+            for request in run["output"].get("action_requests", []):
+                if request.get("action_id") == action_id:
+                    matches.append((run, request))
+        if len(matches) != 1:
+            raise ReconnaissanceAgentNotFound("Action Request is missing or is not uniquely bound to a Recon run")
+        run, request = matches[0]
+        request = normalize_recon_action_request(request)
+        if request["recon_run_id"] != run["recon_run_id"] or request["orchestration_id"] != run["orchestration_id"]:
+            raise ReconnaissanceAgentIntegrityError("Action Request run/orchestration binding mismatch")
+        task_record = self.get_task(request["task_id"])
+        orchestration = self.get_orchestration(request["orchestration_id"])
+        if task_record is None or orchestration is None:
+            raise ReconnaissanceAgentNotFound("Action Request task or orchestration no longer exists")
+        if orchestration["orchestration_status"] != "ACTIVE" or orchestration["pentest_task_id"] != request["task_id"]:
+            raise ReconnaissanceAgentConflict("Action Request orchestration is closed or no longer bound to its task")
+        lifecycle = self.get_lifecycle(request["task_id"])
+        if lifecycle is None or lifecycle.get("state") != "RUNNING":
+            raise ReconnaissanceAgentConflict("Action Request requires the Pentest lifecycle to remain RUNNING")
+        if task_record["task_contract_sha256"] != request["binding"]["task_contract_sha256"]:
+            raise ReconnaissanceAgentConflict("Action Request task contract is stale")
+        task = task_record["task"]
+        if (sha256_hex(task["scope"]) != request["binding"]["scope_sha256"]
+                or sha256_hex(task["constraints"]) != request["binding"]["constraints_sha256"]
+                or sha256_hex(task["authorization_reference"]) != request["binding"]["authorization_reference_sha256"]):
+            raise ReconnaissanceAgentConflict("Action Request scope, constraints, or authorization reference is stale")
+        node = graph_node(orchestration["task_graph"], request["subtask_id"])
+        if (node is None or node.get("capability_id") != RECONNAISSANCE_CAPABILITY_ID
+                or node.get("specialist", {}).get("agent_id") != RECONNAISSANCE_AGENT_ID
+                or node.get("status") not in {"READY", "RUNNING", "SUCCEEDED"}):
+            raise ReconnaissanceAgentConflict("Action Request Recon assignment is no longer valid")
+        if not _target_in_task_scope(
+            {"target_type": request["target_ref"]["target_type"], "target_value": request["target_ref"]["target_value"]}, task
+        ):
+            raise ReconnaissanceAgentConflict("Action Request target is no longer in the current task scope")
+        registry = self.get_capability_registry()
+        if registry["integrity"]["canonical_sha256"] != request["binding"]["capability_registry_sha256"]:
+            raise ReconnaissanceAgentConflict("Action Request capability registry snapshot is stale")
+        proposal_record = self.get_lineage_object(request["proposal_ref"])
+        if (proposal_record["record_type"] != "ACTION_PROPOSAL"
+                or proposal_record["pentest_task_id"] != request["task_id"]
+                or proposal_record["record"]["integrity"]["canonical_sha256"] != request["input_sha256"]):
+            raise ReconnaissanceAgentIntegrityError("Action Request source proposal is missing or has changed")
+        return {
+            "status": "VALIDATED_AWAITING_GSS",
+            "action_id": action_id,
+            "proposal_ref": request["proposal_ref"],
+            "mission_id": request["mission_id"],
+            "task_id": request["task_id"],
+            "orchestration_id": request["orchestration_id"],
+            "recon_run_id": request["recon_run_id"],
+            "current_lifecycle_state": lifecycle["state"],
+            "target_scope_verified": True,
+            "assignment_verified": True,
+            "source_proposal_integrity_verified": True,
+            "gss_authorized": False,
+            "execution_started": False,
+            "external_network_io_performed": False,
+        }
