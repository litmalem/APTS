+    def _validate_proposal_lifecycle_binding(
+        self,
+        *,
+        orchestration_id: str,
+        task_record: Mapping[str, Any],
+        node: Mapping[str, Any],
+        proposal: Mapping[str, Any],
+        capability_registry_sha256: str,
+    ) -> dict[str, Any]:
+        """Re-check current control-plane bindings before publishing a Stage 6 handoff."""
+        current_orchestration = self.get_orchestration(orchestration_id)
+        if current_orchestration is None:
+            raise ReconnaissanceAgentNotFound(f"unknown orchestration: {orchestration_id}")
+        if current_orchestration["orchestration_status"] != "ACTIVE":
+            raise ReconnaissanceAgentConflict(
+                "Recon proposal cannot advance unless its orchestration is ACTIVE"
+            )
+        if current_orchestration["pentest_task_id"] != task_record["pentest_task_id"]:
+            raise ReconnaissanceAgentIntegrityError("orchestration/task binding changed before proposal publication")
+        current_task = self.get_task(task_record["pentest_task_id"])
+        if current_task is None:
+            raise ReconnaissanceAgentNotFound("Pentest task disappeared before proposal publication")
+        if current_task["task_contract_sha256"] != task_record["task_contract_sha256"]:
+            raise ReconnaissanceAgentConflict("Pentest task contract changed before proposal publication")
+        lifecycle = self.get_lifecycle(task_record["pentest_task_id"])
+        if lifecycle is None or lifecycle.get("state") != "RUNNING":
+            state = "MISSING" if lifecycle is None else str(lifecycle.get("state"))
+            raise ReconnaissanceAgentConflict(
+                f"Recon proposal requires Pentest lifecycle RUNNING; observed {state}"
+            )
+        graph = current_orchestration["task_graph"]
+        current_node = graph_node(graph, str(node["subtask_id"]))
+        if current_node is None or current_node.get("capability_id") != RECONNAISSANCE_CAPABILITY_ID:
+            raise ReconnaissanceAgentIntegrityError("Recon subtask is absent from the active orchestration graph")
+        if current_node.get("specialist", {}).get("agent_id") != RECONNAISSANCE_AGENT_ID:
+            raise ReconnaissanceAgentIntegrityError("Recon subtask is not assigned to the canonical Recon agent")
+        if current_node.get("status") not in {"READY", "RUNNING"}:
+            raise ReconnaissanceAgentConflict(
+                f"Recon proposal cannot advance from subtask status {current_node.get('status')}"
+            )
+        if current_node.get("subtask_id") != node.get("subtask_id"):
+            raise ReconnaissanceAgentIntegrityError("Recon subtask identity changed before proposal publication")
+        if not _target_in_task_scope(proposal["target"], current_task["task"]):
+            raise ReconnaissanceAgentConflict("Recon proposal target is outside the current task scope")
+        current_capabilities = self.get_capability_registry()
+        if current_capabilities["integrity"]["canonical_sha256"] != capability_registry_sha256:
+            raise ReconnaissanceAgentConflict("Capability registry changed before proposal publication")
+        if proposal.get("technique") != "PASSIVE_DISCOVERY" or proposal.get("capability_id", RECONNAISSANCE_CAPABILITY_ID) != RECONNAISSANCE_CAPABILITY_ID:
+            raise ReconnaissanceAgentValidationError("proposal capability/technique is not enabled for Recon")
+
+        graph_sha = sha256_hex(graph)
+        lifecycle_binding = {
+            "mission_id": task_record["mission_id"],
+            "pentest_id": task_record["pentest_id"],
+            "task_id": task_record["pentest_task_id"],
+            "task_contract_sha256": current_task["task_contract_sha256"],
+            "orchestration_id": current_orchestration["orchestration_id"],
+            "orchestration_graph_sha256": graph_sha,
+            "subtask_id": current_node["subtask_id"],
+            "assigned_agent_id": current_node["specialist"]["agent_id"],
+            "lifecycle_state": lifecycle["state"],
+            "lifecycle_state_version": lifecycle["state_version"],
+            "scope_sha256": sha256_hex(current_task["task"]["scope"]),
+            "constraints_sha256": sha256_hex(current_task["task"]["constraints"]),
+            "authorization_reference_sha256": sha256_hex(current_task["task"]["authorization_reference"]),
+            "capability_registry_sha256": capability_registry_sha256,
+            "target": deepcopy(proposal["target"]),
+        }
+        binding_sha = sha256_hex({
+            "hash_domain": "APTS_STAGE5_2_RECON_PROPOSAL_LIFECYCLE_BINDING_V1",
+            "binding": lifecycle_binding,
+        })
+        return {
+            "schema_version": RECON_PROPOSAL_LIFECYCLE_SCHEMA_VERSION,
+            "current_status": "AWAITING_STAGE6_INTAKE",
+            "binding": lifecycle_binding,
+            "binding_sha256": binding_sha,
+            "transitions": [
+                {"sequence": 1, "from_status": None, "to_status": "PROPOSED", "gate": "RECON_NEED_DERIVED"},
+                {"sequence": 2, "from_status": "PROPOSED", "to_status": "VALIDATED", "gate": "ORCHESTRATION_TASK_ASSIGNMENT_SCOPE_REGISTRY"},
+                {"sequence": 3, "from_status": "VALIDATED", "to_status": "AWAITING_STAGE6_INTAKE", "gate": "GSS_AUTHORIZATION_STILL_REQUIRED"},
+            ],
+            "semantics": {
+                "append_only_snapshot": True,
+                "gss_authorized": False,
+                "execution_started": False,
+                "external_network_io_performed": False,
+            },
+        }
