# Base URL Mission for read-only canonical Mission lookup and governed WPT intake.
MISSION_API_BASE_URL=http://127.0.0.1:8780
# Base URL Mission for governed WPT intake, e.g. http://127.0.0.1:8780
APTS_WTP_DISPATCH_URL=
# Bearer token shared with MISSION_WPT_INTAKE_TOKEN (minimum 32 characters)
APTS_WTP_DISPATCH_TOKEN=
# Optional token for authenticating non-loopback WPT API clients
WTP_CLIENT_TOKEN=

# Keep Mission in PLANNING until its planned Pentest orchestration task has been
# durably accepted by Pentest; this lets governed GSS/PIP handoff retry safely.
APTS_REQUIRE_PENTEST_ORCHESTRATION_BEFORE_RUNNING=1

# Automatically queue the exact Recon-declared URL in WPT after the Mission is
# RUNNING and the current Pentest task, scope, RoE, and budget checks pass.
# Intake only queues a Stage 6 request; it does not authorize target I/O.
APTS_AUTONOMOUS_WPT_INTAKE=1

# Mission -> WPT governed-intake receiver. The token must equal WTP_CLIENT_TOKEN
# in the WPT process and contain at least 32 characters.
APTS_WPT_INBOX_URL=http://127.0.0.1:8791
APTS_WPT_INBOX_TOKEN=
