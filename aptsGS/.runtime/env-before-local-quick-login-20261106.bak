# Governance API
GOV_HOST=127.0.0.1
GOV_PORT=8770
GOV_LOG_LEVEL=INFO
GOV_DECISION_TTL_SECONDS=300
GOV_APPROVAL_TTL_SECONDS=900
GOV_OUTBOX_POLL_SECONDS=2.0

# MariaDB - dedicated Governance database
GOV_DB_HOST=127.0.0.1
GOV_DB_PORT=3307
GOV_DB_NAME=apts_governance
GOV_DB_USER=root
GOV_DB_PASSWORD=tigad

# Optional integration with VulnDesk CTI Event-Driven API
# VulnDesk API defaults to 127.0.0.1:8765 in the current CTI implementation.
CTI_EVENT_API_URL=http://127.0.0.1:8765/api/cti/events/publish
CTI_EVENT_API_TIMEOUT_SECONDS=5

# Development only. Keep false outside local development.
GOV_DEBUG=false
GOV_APPROVAL_PRINCIPALS_FILE=D:/aptsGS/.secrets/governance-principals.json
